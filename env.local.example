# ==============================================================================
# EchoOps Backend Configuration & Secrets Template
# ==============================================================================

# 1. Agora Platform Credentials (Required for Live Voice & RTM)
# Found in Agora Console -> Your Project
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# 2. Agora Customer REST API (Optional: Cloud Recording & Analytics)
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=

# 3. PostgreSQL Database with pgvector (Optional - In-Memory Fallback Available)
DATABASE_URL=postgresql://echoops_user:password@localhost:5432/echoops

# 4. Slack War Room Integration (Optional Webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
SLACK_CHANNEL=#incident-war-room

# 5. Jira Auto-Ticketing Integration (Optional)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=sre-bot@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=OPS

# 6. PagerDuty Incident Escalation (Optional)
PAGERDUTY_ROUTING_KEY=your_pd_routing_key
